#include <metal_stdlib>
using namespace metal;

struct VertexInput {
    float4 position [[position]];
    float3 normal;
    float2 uv;
};

struct FragmentUniforms {
    float4 texture_mix;
};

fragment float4 fragment_main(
    VertexInput input [[stage_in]],
    texture2d<float> color_texture [[texture(0)]],
    sampler color_sampler [[sampler(0)]],
    constant FragmentUniforms &uniforms [[buffer(0)]])
{
    float4 uv_color = float4(
        input.uv.x,
        input.uv.y,
        0.0,
        1.0
    );

    float4 texture_color =
        color_texture.sample(color_sampler, input.uv);

    float3 normal = normalize(input.normal); 

    float3 light_direction = normalize(
        float3(-1.0, 1.0, -1.0)
    );

    float diffuse_strength = max(
        dot(normal, light_direction),
        0.0
    );

    float ambient_strength = 0.25;
    float sunlight_strength = 1.0;

    float light_intensity = min(
        ambient_strength +
        sunlight_strength * diffuse_strength,
        1.0
    );

    float4 lit_texture_color = float4(
        texture_color.rgb * light_intensity,
        texture_color.a
    );

    return mix(
        uv_color,
        lit_texture_color,
        uniforms.texture_mix.x
    );
}
